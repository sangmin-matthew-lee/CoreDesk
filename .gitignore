/data/
/data/*
*.db
*.db-*
*.sqlite
*.sqlite3
*.sql
*.dump
*.bak

# Spreadsheet & Report Exports (CRITICAL - Customer Lead & Financial Data)
*.xlsx
*.xls
*.csv
*.tsv

# Debug & Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log.*

# Environment variables & secrets (CRITICAL for security)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
.env.development
.env.test
.env.production
.env.staging
.env.backup
*.env
*.env.*

# Credentials, Service Account Keys & API Keys (CRITICAL for security)
*credentials*.json
*secret*.json
*service-account*.json
*service_account*.json
*gcp*.json
*firebase*.json
jwt-secret*

# Encryption keys, certificates & private keys (CRITICAL for security)
*.pem
*.key
*.pub
*.cert
*.cer
*.crt
*.pfx
*.p12
*.pkcs12
*.ssh
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*

# Scratch & Temporary Testing Folders
/scratch/
scratch/
temp/
tmp/
*.tmp

# AI Assistants & Local Agent Cache
.agents/
.claude/
.gemini/

